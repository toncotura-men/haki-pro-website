{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/kenkou-keiei",
      "destination": "/kenkou-keiei/",
      "permanent": true
    },
    {
      "source": "/pumps",
      "destination": "/pumps/",
      "permanent": true
    },
    {
      "source": "/heros-cup",
      "destination": "/heros-cup/",
      "permanent": true
    },
    {
      "source": "/raise-children",
      "destination": "/ball-recycle/",
      "permanent": true
    },
    {
      "source": "/raise-children/",
      "destination": "/ball-recycle/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/kenkou-keiei/k/:path+",
      "destination": "https://pumps-tracker-v2.vercel.app/:path+"
    },
    {
      "source": "/kenkou-keiei/",
      "destination": "https://pumps-tracker-v2.vercel.app/kenko.html"
    },
    {
      "source": "/kenkou-keiei/admin",
      "destination": "https://pumps-tracker-v2.vercel.app/kenko-admin.html"
    },
    {
      "source": "/kenkou-keiei/sample",
      "destination": "https://pumps-tracker-v2.vercel.app/kenko-admin.html"
    },
    {
      "source": "/pumps/",
      "destination": "https://toncotura-men.github.io/company-website/index.html"
    },
    {
      "source": "/heros-cup/",
      "destination": "https://toncotura-men.github.io/company-website/heros-cup/index.html"
    },
    {
      "source": "/pumps/:path+",
      "destination": "https://toncotura-men.github.io/company-website/:path+"
    },
    {
      "source": "/heros-cup/:path+",
      "destination": "https://toncotura-men.github.io/company-website/heros-cup/:path+"
    }
  ]
}
