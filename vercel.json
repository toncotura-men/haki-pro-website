{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/pumps",
      "destination": "/pumps/",
      "permanent": true
    },
    {
      "source": "/heros-cup",
      "destination": "/heros-cup/",
      "permanent": true
    },
    {
      "source": "/raise-children",
      "destination": "/ball-recycle/",
      "permanent": true
    },
    {
      "source": "/raise-children/",
      "destination": "/ball-recycle/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/pumps/",
      "destination": "https://toncotura-men.github.io/company-website/index.html"
    },
    {
      "source": "/heros-cup/",
      "destination": "https://toncotura-men.github.io/company-website/heros-cup/index.html"
    },
    {
      "source": "/pumps/:path+",
      "destination": "https://toncotura-men.github.io/company-website/:path+"
    },
    {
      "source": "/heros-cup/:path+",
      "destination": "https://toncotura-men.github.io/company-website/heros-cup/:path+"
    }
  ]
}
